                      "parameters":  {
                                         "jsCode":  "const items = $input.all().map((i) =\u003e i.json?.row || i.json);\nconst esc = (s) =\u003e String(s ?? \u0027\u0027).replace(/\u0026/g, \u0027\u0026amp;\u0027).replace(/\u003c/g, \u0027\u0026lt;\u0027).replace(/\u003e/g, \u0027\u0026gt;\u0027).replace(/\"/g, \u0027\u0026quot;\u0027);\nconst cards = items.map((r) =\u003e {\n  const word = esc(r.word);\n  return \u0027\u003carticle class=\"card\" data-word=\"\u0027 + word.toLowerCase() + \u0027\" data-meaning=\"\u0027 + esc(r.meaning_zh) + \u0027\"\u003e\u003ch2\u003e\u0027 + word + \u0027\u003c/h2\u003e\u003cdiv class=\"meta\"\u003e\u003cspan class=\"badge\"\u003e解釋：\u0027 + esc(r.meaning_zh) + \u0027\u003c/span\u003e\u003cspan class=\"badge\"\u003e補充：\u0027 + esc(r.extra || \u0027Empty\u0027) + \u0027\u003c/span\u003e\u003cspan class=\"badge pos\"\u003e\u0027 + esc(r.pos) + \u0027\u003c/span\u003e\u003cspan class=\"badge prog\"\u003e\u0027 + esc(r.progress || \u0027不熟\u0027) + \u0027\u003c/span\u003e\u003c/div\u003e\u003cp class=\"ex\"\u003e\u0027 + esc(r.example_en) + \u0027\u003c/p\u003e\u003cdiv class=\"row\"\u003e\u003caudio controls preload=\"none\" src=\"\u0027 + esc(r.tts_url) + \u0027\"\u003e\u003c/audio\u003e\u003cbutton onclick=\"mark(\\\u0027\u0027 + word + \u0027\\\u0027,\\\u0027已會\\\u0027)\"\u003e已會\u003c/button\u003e\u003cbutton onclick=\"mark(\\\u0027\u0027 + word + \u0027\\\u0027,\\\u0027不熟\\\u0027)\"\u003e不熟\u003c/button\u003e\u003c/div\u003e\u003c/article\u003e\u0027;\n}).join(\u0027\\n\u0027);\nconst html = \u0027\u003c!DOCTYPE html\u003e\u003chtml lang=\"zh-Hant\"\u003e\u003chead\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1\"\u003e\u003ctitle\u003e英文單字卡\u003c/title\u003e\u003cstyle\u003ebody{font-family:sans-serif;max-width:900px;margin:0 auto;padding:16px}.toolbar{position:sticky;top:0;background:#fff;padding:8px 0;display:flex;gap:8px}.card{border:1px solid #ddd;border-radius:12px;padding:16px;margin:12px 0}.card h2{font-size:2em;margin:0 0 8px}.badge{display:inline-block;background:#f2f2f2;border-radius:6px;padding:2px 8px;margin:2px 4px 2px 0;font-size:.85em}.pos{background:#fef3c7}.ex{margin:12px 0}.row{display:flex;gap:8px;align-items:center}#focus{border:2px solid #333;border-radius:12px;padding:8px;margin:12px 0}\u003c/style\u003e\u003c/head\u003e\u003cbody\u003e\u003ch1\u003e英文單字卡（共 \u0027 + items.length + \u0027 字）\u003c/h1\u003e\u003cdiv class=\"toolbar\"\u003e\u003cinput id=\"q\" placeholder=\"搜尋單字或中文解釋…\" oninput=\"filter()\" style=\"flex:1;padding:8px\"\u003e\u003cbutton onclick=\"random()\"\u003e隨機抽卡\u003c/button\u003e\u003c/div\u003e\u003cdiv id=\"focus\"\u003e\u003c/div\u003e\u003cdiv id=\"list\"\u003e\u0027 + cards + \u0027\u003c/div\u003e\u003cscript\u003evar prog=JSON.parse(localStorage.getItem(\\\u0027vocabProg\\\u0027)||\\\u0027{}\\\u0027);function paint(){document.querySelectorAll(\\\u0027.prog\\\u0027).forEach(function(b){var w=b.closest(\\\u0027.card\\\u0027).dataset.word;if(prog[w])b.textContent=prog[w];});}function mark(w,s){prog[w.toLowerCase()]=s;localStorage.setItem(\\\u0027vocabProg\\\u0027,JSON.stringify(prog));paint();}function filter(){var q=document.getElementById(\\\u0027q\\\u0027).value.toLowerCase();document.querySelectorAll(\\\u0027#list .card\\\u0027).forEach(function(c){c.style.display=(c.dataset.word.indexOf(q)\u003e-1||c.dataset.meaning.indexOf(q)\u003e-1)?\\\u0027\\\u0027:\\\u0027none\\\u0027;});}function random(){var cs=[...document.querySelectorAll(\\\u0027#list .card\\\u0027)].filter(function(c){return c.style.display!==\\\u0027none\\\u0027;});if(!cs.length)return;var c=cs[Math.floor(Math.random()*cs.length)];var f=document.getElementById(\\\u0027focus\\\u0027);f.innerHTML=\\\u0027\u003ch3\u003e抽卡複習\u003c/h3\u003e\\\u0027;f.appendChild(c.cloneNode(true));window.scrollTo(0,0);}paint();\u003c/script\u003e\u003c/body\u003e\u003c/html\u003e\u0027;\nreturn [{ json: { html } }];"
                                     },
