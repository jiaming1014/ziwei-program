                                         "jsCode":  "const letters = \u0027ABCDEFGHIJKLMNOPQRSTUVWXYZ\u0027.split(\u0027\u0027);\nconst topics = [\u0027職場溝通\u0027,\u0027旅遊交通\u0027,\u0027餐飲美食\u0027,\u0027科技網路\u0027,\u0027健康醫療\u0027,\u0027教育學習\u0027,\u0027商業金融\u0027,\u0027環境氣候\u0027,\u0027運動休閒\u0027,\u0027文化藝術\u0027,\u0027政治法律\u0027,\u0027科學研究\u0027,\u0027家庭生活\u0027,\u0027購物消費\u0027,\u0027社交情感\u0027,\u0027日常時間\u0027,\u0027自然動物\u0027,\u0027城市生活\u0027,\u0027求職面試\u0027,\u0027商務書信\u0027,\u0027會議簡報\u0027,\u0027客服應對\u0027,\u0027天氣季節\u0027,\u0027興趣愛好\u0027];\nconst seeds = [\n  ...letters.map((L) =\u003e ({ json: { hint: `以 ${L} 開頭的常用英文單字` } })),\n  ...topics.map((t) =\u003e ({ json: { hint: `主題「${t}」相關的常用英文單字` } })),\n];\nreturn seeds;"
                                     },
