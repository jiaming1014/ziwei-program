                      "id":  "ollama-node",
                      "name":  "Ollama 產生單字",
                      "position":  [
                                       688,
                                       0
                                   ],
                      "type":  "@n8n/n8n-nodes-langchain.ollama",
                      "typeVersion":  1,
                      "credentials":  {
                                          "ollamaApi":  {
                                                            "id":  "PtH6pPJVZmhVy1SX",
                                                            "name":  "Ollama account"
                                                        }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const existing = new Set(\n  $(\u0027讀取已有單字\u0027).all().map((i) =\u003e {\n    const r = i.json?.row ?? i.json ?? {};\n    return String(r.word ?? \u0027\u0027).trim().toLowerCase();\n  }).filter(Boolean)\n);\nconst seen = new Set();\nconst rows = [];\nfor (const item of $input.all()) {\n  const j = item.json ?? {};\n  let raw = j.text ?? j.output ?? j.content ?? \u0027\u0027;\n  if (typeof raw !== \u0027string\u0027) raw = JSON.stringify(j);\n  raw = String(raw).replace(/```json/gi, \u0027\u0027).replace(/```/g, \u0027\u0027).trim();\n  let arr;\n  try { arr = JSON.parse(raw); }\n  catch (e) {\n    const m = String(raw).match(/\\[[\\s\\S]*\\]/);\n    if (!m) continue;\n    try { arr = JSON.parse(m[0]); } catch (e2) { continue; }\n  }\n  if (!Array.isArray(arr)) continue;\n  for (const w of arr) {\n    const word = String(w.word ?? \u0027\u0027).trim();\n    const key = word.toLowerCase();\n    if (!key || existing.has(key) || seen.has(key)) continue;\n    seen.add(key);\n    rows.push({ json: {\n      word,\n      meaning_zh: String(w.meaning_zh ?? \u0027\u0027),\n      extra: \u0027\u0027,\n      pos: String(w.pos ?? \u0027\u0027),\n      progress: \u0027不熟\u0027,\n      example_en: String(w.example_en ?? \u0027\u0027),\n      tts_url: \u0027https://translate.google.com/translate_tts?ie=UTF-8\u0026tl=en\u0026client=tw-ob\u0026q=\u0027 + encodeURIComponent(word)\n    }});\n  }\n}\nreturn rows;"
                                     },
