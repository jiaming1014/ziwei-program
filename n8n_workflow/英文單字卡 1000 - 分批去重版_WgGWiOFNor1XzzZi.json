                                                          "values":  [
                                                                         {
                                                                             "content":  "=請產生 20 個「{{ $json.hint }}」、適合台灣高中到多益程度的常用英文單字（不要 the/be 這類最常見字）。只輸出純 JSON 陣列，不要 markdown、不要解釋。每個元素格式：{\"word\": \"polish\", \"meaning_zh\": \"擦亮、改進\", \"pos\": \"動詞\", \"example_en\": \"You should polish your English speaking skills before going abroad.\"}。pos 請用繁體中文（名詞/動詞/形容詞/副詞等）。example_en 要自然實用、包含該單字。"
                                                                         }
                                                                     ]
                                                      },
                                         "options":  {
                                                         "temperature":  0.7,
                                                         "num_predict":  4000,
                                                         "format":  "json"
                                                     }
