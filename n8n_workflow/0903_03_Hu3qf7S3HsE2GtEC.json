                  {
                      "parameters":  {
                                         "jsCode":  "const out = $input.first().json?.output || {};\nconst rawMsg = $(\u0027模擬自然語言訂購留言\u0027).first().json?.raw_message || \u0027\u0027;\nconst items = Array.isArray(out.order_items) ? out.order_items : [];\nconst base = {\n  \u0027留言日期\u0027: out.order_date || \u0027\u0027,\n  \u0027客戶名稱\u0027: out.customer_name || \u0027未知客戶\u0027,\n  \u0027聯絡電話\u0027: out.phone || \u0027\u0027,\n  \u0027收件地址\u0027: out.shipping_address || \u0027\u0027,\n  \u0027統一編號\u0027: out.tax_id || \u0027\u0027,\n  \u0027備註\u0027: out.remark || \u0027\u0027,\n  \u0027原始留言\u0027: rawMsg\n};\nif (items.length === 0) {\n  return [{ json: { ...base, \u0027商品名稱\u0027: \u0027\u0027, \u0027數量\u0027: 0, \u0027單價\u0027: 0, \u0027總價\u0027: 0 } }];\n}\nreturn items.map((e) =\u003e {\n  const qty = Number(e.quantity) || 0;\n  const price = Number(e.unit_price) || 0;\n  const total = Number(e.item_total) || (qty * price);\n  return { json: { ...base, \u0027商品名稱\u0027: e.item_name || \u0027\u0027, \u0027數量\u0027: qty, \u0027單價\u0027: price, \u0027總價\u0027: total } };\n});"
                                     },
